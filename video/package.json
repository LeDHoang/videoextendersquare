{
  "name": "echo-video",
  "private": true,
  "version": "0.1.0",
  "description": "ECHO promo / intro videos (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render:30": "remotion render EchoIntro30 ../reports/video/echo-intro-30s.mp4",
    "render:60": "remotion render EchoIntro60 ../reports/video/echo-intro-60s.mp4",
    "render:vision": "remotion render EchoVision30 ../reports/video/echo-vision-30s.mp4 --concurrency=2 --image-format=png",
    "share:vision": "bash scripts/share-vision.sh",
    "stills:vision": "node scripts/vision-stills.mjs",
    "media": "bash scripts/prepare-media.sh",
    "capture:web": "node scripts/capture-web.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/media-utils": "4.0.536",
    "@remotion/three": "4.0.536",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.536",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
