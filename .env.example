# Platform fal.ai API key used only for ECHO Credit-funded cloud jobs
# Get one at https://fal.ai/dashboard/keys
FAL_KEY=

# ECHO Credits rollout flags. Keep disabled until migrations, Stripe test mode,
# and low-cost fal.ai reconciliation checks have passed.
SX_CREDITS_ENABLED=0
SX_STRIPE_ENABLED=0
SX_REEL_REWARDS_ENABLED=0

# Stable, dedicated secret used to encrypt per-user Fal keys at rest.
# Generate independently from the session/message secrets; loss prevents decrypting saved keys.
SX_FAL_KEY_ENCRYPTION_KEY=change-this-to-a-third-long-random-value

# Stripe Checkout and raw-body webhook verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SX_STRIPE_PRICE_500=
SX_STRIPE_PRICE_1050=
SX_STRIPE_PRICE_2750=
# Browser-visible origin used in Checkout success/cancel URLs.
SX_PUBLIC_BASE_URL=http://localhost:5173

# Maximum eligible reel claims per keyed IP and UTC day (5 credits = 50 claims).
SX_REEL_REWARD_IP_DAILY_CLAIMS=50

# Optional: override ffmpeg location if not on PATH
# FFMPEG_DIR=C:\path\to\ffmpeg\bin

# Social database (defaults to sqlite:///./data/echo.db)
# DATABASE_URL=postgresql+psycopg://echo:password@localhost/echo

# Set to 1 when served over HTTPS
SX_COOKIE_SECURE=0
SX_SESSION_DAYS=30
SX_REGISTRATION_ENABLED=1
# Required in production; used to HMAC rate-limit and session metadata
SX_SECURITY_SECRET=change-this-to-a-long-random-value
# Required for direct messaging. Use a separate, stable random secret.
# Changing or losing it makes existing messages and report evidence unreadable.
SX_MESSAGE_ENCRYPTION_KEY=change-this-to-a-separate-long-random-value

# Optional Tenor GIF search. Leave the API key blank to disable GIF search.
SX_TENOR_API_KEY=
SX_TENOR_CLIENT_KEY=echo_reels
# Only HTTPS GIF URLs from these hosts can be stored in messages.
SX_TENOR_ALLOWED_HOSTS=media.tenor.com,media1.tenor.com
# Enable only behind a trusted proxy that overwrites X-Forwarded-For
SX_TRUST_PROXY_HEADERS=0
# Comma-separated usernames or emails promoted when they sign in
SX_ADMIN_USERS=
SX_MODERATOR_USERS=

# Password reset delivery
SX_PUBLIC_URL=http://localhost:5173
SX_SMTP_HOST=
SX_SMTP_PORT=465
SX_SMTP_USERNAME=
SX_SMTP_PASSWORD=
SX_SMTP_FROM=
SX_SMTP_SSL=1
SX_SMTP_STARTTLS=1
# Local development only; never enable in production
SX_PASSWORD_RESET_EXPOSE_TOKEN=0
