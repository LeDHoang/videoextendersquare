# SIT .env template for compose.yaml + deploy/compose.sit.yaml, on the prod
# VPS as the unix user echosit (rootless Docker). Runbook: docs/sit-runbook.md.
#
#   cp deploy/env.sit.example ~/echo-sit/.env && chmod 600 ~/echo-sit/.env
#
# Same production mode and boot checks as deploy/env.example (server/settings.py).
# Replace every <...> value with a fresh one generated for SIT:
#
#   openssl rand -base64 48      # SX_* secrets (>= 32 chars, never reused)
#   openssl rand -hex 32         # POSTGRES_PASSWORD (hex: safe inside a URL)
#
# Never copy a value from prod's .env: SIT runs dev code, and anything it can
# read must be worthless to prod. SIT data is disposable, so its secrets need
# no escrow.

# ── Compose wiring ──────────────────────────────────────────────────────────
COMPOSE_FILE=compose.yaml:deploy/compose.sit.yaml
# Loopback ports; prod holds 8000 and 8080 (the nftables rule blocks those
# for echosit). deploy.sh polls SX_APP_PORT for readiness.
SX_APP_PORT=8001
SX_PROXY_PORT=8081

# ── Mode ────────────────────────────────────────────────────────────────────
SX_ENV=production
SX_LOG_LEVEL=INFO
# One JSON object per log line, each with a request_id (matches X-Request-ID).
SX_LOG_FORMAT=json
# Report-only CSP for the beta; switch to enforce before the public launch
# once the logs show no csp-report lines (docs/to-beta.md).
SX_CSP_MODE=report
# Seconds running jobs get to finish on shutdown; queued jobs are cancelled and
# refunded. Keep it below uvicorn's 20 s and compose's stop_grace_period.
SX_SHUTDOWN_DRAIN_S=15
SENTRY_DSN=<sentry-dsn>
# Same project as prod; events are tagged sit, and prod alerts filter on
# environment:production (docs/sit-runbook.md).
SENTRY_ENVIRONMENT=sit
# Share of requests traced (health checks never are). 5M spans/month are free.
SENTRY_TRACES_SAMPLE_RATE=0.2
# Optional: shows the unresolved Sentry issues on the moderation Overview (admins).
# A Sentry auth token with only event:read. The DSN above can only send.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# The org's region API, e.g. https://us.sentry.io or https://de.sentry.io.
SENTRY_API_URL=https://sentry.io

# ── Public URLs ─────────────────────────────────────────────────────────────
# Must be https://. SX_PUBLIC_URL is the app origin, SX_MEDIA_BASE_URL the
# R2 public bucket's custom domain (sit-media.<domain>).
SX_PUBLIC_URL=https://sit.echomultiverse.com
SX_PUBLIC_BASE_URL=https://sit.echomultiverse.com
SX_MEDIA_BASE_URL=https://sit-media.echomultiverse.com
# Empty in production; localhost origins are rejected at boot.
SX_DEV_ORIGINS=

# ── Behind Cloudflare Tunnel ────────────────────────────────────────────────
SX_COOKIE_SECURE=1
SX_TRUST_PROXY_HEADERS=1
# cloudflared connector token (Zero Trust -> Networks -> Tunnels). Read by
# the cloudflared service in compose.yaml (`--profile tunnel`).
TUNNEL_TOKEN=<echo-sit-tunnel-token>

# ── Database (postgres:16 service in compose.yaml) ──────────────────────────
# compose.yaml builds DATABASE_URL for the app from these three values, so
# they cannot drift; it overrides any DATABASE_URL set in this file:
#   DATABASE_URL=postgresql+psycopg://echo:<POSTGRES_PASSWORD>@postgres:5432/echo
POSTGRES_USER=echo
POSTGRES_PASSWORD=<openssl-rand-hex-32>
POSTGRES_DB=echo

# ── Secrets (each >= 32 chars, independent, never the dev default) ──────────
SX_SECURITY_SECRET=<long-random-secret>
SX_MESSAGE_ENCRYPTION_KEY=<different-long-random-secret>
SX_FAL_KEY_ENCRYPTION_KEY=<third-independent-long-random-secret>

# ── Cloudflare R2 (public media bucket) ─────────────────────────────────────
# SIT's own bucket (custom domain sit-media.<domain>) and its own token,
# Object Read & Write on that bucket only. Never prod's token or bucket.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_PUBLIC_BUCKET=<sit-public-bucket-name>

# ── fal.ai ──────────────────────────────────────────────────────────────────
# Blank: SIT never spends on the platform fal key (platform generation reports
# "temporarily unavailable"). A tester's own saved fal key (BYOK) still works.
FAL_KEY=
SX_FAL_MAX_QUOTE_USD=10

# ── Access ──────────────────────────────────────────────────────────────────
SX_REGISTRATION_ENABLED=0
SX_REGISTRATION_ALLOWLIST=<your-email>,<probe-email>,<probe-peer-email>
SX_SESSION_DAYS=30
# Your own SIT account, never a probe account (their password sits in CI).
SX_ADMIN_USERS=<your-sit-username-or-email>
SX_MODERATOR_USERS=
SX_PASSWORD_RESET_EXPOSE_TOKEN=0
# Email verification link lifetime in minutes (an account exists only after it is used).
SX_EMAIL_VERIFY_TTL_MIN=1440
# Cloudflare Turnstile for sign-up. With the secret unset the check is skipped.
SX_TURNSTILE_SITE_KEY=
SX_TURNSTILE_SECRET=

# ── Capacity (OVHcloud VPS-2: 4 vCPU / 8 GB; app container capped at 3 CPUs) ──
SX_MAX_VIDEO_UPLOAD_MB=95
SX_MAX_IMAGE_UPLOAD_MB=50
SX_UPLOAD_HOURLY_MAX=30
SX_REGISTER_DEVICE_HOURLY=3
SX_REGISTER_DEVICE_DAILY=5
SX_VIDEO_WORKERS=1
SX_IMAGE_WORKERS=2
# Read-only processes in the app-read service (docs/deploy-runbook.md, "Read
# service"). One core and up to 15 database connections each.
SX_READ_WORKERS=1
SX_MAX_PENDING_JOBS=6
SX_MAX_JOBS_PER_USER=2
# Trust tiers (server/trust.py): accounts younger than this get the lower
# "new" limits (SX_NEW_UPLOAD_HOURLY_MAX etc.); see RUNNING.md.
SX_TRUST_NEW_HOURS=72
SX_TRUST_TRUSTED_DAYS=30
# Ceiling on bytes held in staged uploads (container /tmp) at once: 2 GiB.
SX_STAGED_BYTES_MAX=2147483648
SX_DISK_MIN_FREE_GB=10
SX_JOB_RETENTION_S=21600
SX_FFMPEG_THREADS=2
# nice level for every ffmpeg call (deploy/ffmpeg-nice.sh).
SX_FFMPEG_NICE=19

# ── Cost / abuse controls ───────────────────────────────────────────────────
SX_QUOTE_RPM=15
SX_PACK_CREATE_HOURLY=10
SX_PUBLISH_HOURLY_MAX=60
SX_PUBLISH_DAILY_MAX=200
SX_SSE_MAX_CONN=8
SX_SSE_MAX_MIN=30
# View and event writes per actor per minute (the per-IP limit is 5x), and the
# contributions one actor can add to one post per day without an impression.
SX_EVENT_RPM=120
SX_EVENT_DAILY_CAP=5
# Moderation overview: smallest count that can be flagged as a spike.
SX_MOD_SPIKE_MIN=10
# Per-account alerts (sx.alerts, Moderation > Overview > Flagged accounts).
SX_ALERT_USER_SPEND_HOURLY=300
SX_ALERT_NEW_ACCOUNT_SPEND=100
SX_ALERT_ACCOUNTS_PER_IP=5
SX_ALERT_ACCOUNTS_PER_DEVICE=3
# People reporting one target in 24 h / one account in 7 days, and actions per
# hour by a new account, before a per-account alert. An admin scales all the
# alert limits here at runtime (Moderation > Overview > Alert sensitivity).
SX_ALERT_REPORTERS_PER_TARGET=3
SX_ALERT_REPORTERS_PER_ACCOUNT=5
SX_ALERT_NEW_ACCOUNT_ACTIVITY=30

# ── Reel Packs: launch decision is ON for the beta (docs/to-beta.md) ────────
SX_REEL_PACK_CREATION_ENABLED=1
SX_REEL_PACK_DISCOVERY_ENABLED=1
SX_REEL_PACK_IMMERSIVE_ENABLED=1

# ── Credits / Stripe: off for the beta ──────────────────────────────────────
SX_CREDITS_ENABLED=0
SX_STRIPE_ENABLED=0
SX_REEL_REWARDS_ENABLED=0
SX_REEL_REWARD_IP_DAILY_CLAIMS=50
SX_REEL_REWARD_MIN_ACCOUNT_AGE_HOURS=72
# Granted once on email verification while credits are on.
SX_STARTER_CREDITS=5
# Credits per account per UTC day (new accounts: SX_NEW_DAILY_CREDIT_CAP, 100).
SX_DAILY_CREDIT_CAP=1000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SX_STRIPE_PRICE_500=
SX_STRIPE_PRICE_1050=
SX_STRIPE_PRICE_2750=
SX_STRIPE_WEBHOOK_MAX_BYTES=1048576
SX_STRIPE_WEBHOOK_RPM=120

# ── GIF search (optional; blank key disables it) ────────────────────────────
SX_TENOR_API_KEY=
SX_TENOR_CLIENT_KEY=echo_reels
SX_TENOR_ALLOWED_HOSTS=media.tenor.com,media1.tenor.com

# ── Mailpit (deploy/compose.sit.yaml), plain SMTP on the compose network ─────
SX_SMTP_HOST=mailpit
SX_SMTP_PORT=1025
SX_SMTP_USERNAME=
SX_SMTP_PASSWORD=
SX_SMTP_FROM=no-reply@sit.echomultiverse.com
SX_SMTP_SSL=0
SX_SMTP_STARTTLS=0

# ── Support inbox ────────────────────────────────────────────────────────────
# Gets one email per /support request (category, ID, subject; no body).
# Blank logs the request only. Uses the SMTP settings above.
SX_SUPPORT_EMAIL=
