# Local staging .env for compose.yaml + deploy/compose.staging.yaml.
# Runbook: docs/local-staging.md.
#
#   cp deploy/env.staging.example .env.staging && chmod 600 .env.staging
#   docker compose --env-file .env.staging up -d --build
#
# Same production mode and boot checks as deploy/env.example. Only the edges
# differ: SeaweedFS instead of R2, Caddy instead of the Tunnel, Mailpit instead of
# a real SMTP provider. Replace every <...> value (openssl rand -base64 48 for
# the SX_* secrets, openssl rand -hex 32 for the passwords). Never reuse these
# values in production.

# ── Compose wiring (read by `docker compose --env-file .env.staging`) ───────
COMPOSE_FILE=compose.yaml:deploy/compose.staging.yaml
COMPOSE_PROJECT_NAME=echo-staging
SX_ENV_FILE=.env.staging
# compose.yaml requires a value even though the tunnel profile stays off here.
TUNNEL_TOKEN=unused-in-staging
# Loopback port for the app container (8000 is usually the dev server).
SX_APP_PORT=8001

# ── Mode ────────────────────────────────────────────────────────────────────
SX_ENV=production
SX_LOG_LEVEL=INFO
# One JSON object per log line, each with a request_id (matches X-Request-ID).
SX_LOG_FORMAT=json
# Report-only CSP for the beta; switch to enforce before the public launch
# once the logs show no csp-report lines (docs/to-beta.md).
SX_CSP_MODE=report
# Seconds running jobs get to finish on shutdown; queued jobs are cancelled and
# refunded. Keep it below uvicorn's 20 s and compose's stop_grace_period.
SX_SHUTDOWN_DRAIN_S=15
# Optional: a free Sentry developer-tier DSN to test error reporting.
SENTRY_DSN=

# ── Public URLs (Caddy, deploy/Caddyfile.staging) ───────────────────────────
SX_PUBLIC_URL=https://localhost:8443
SX_PUBLIC_BASE_URL=https://localhost:8443
SX_MEDIA_BASE_URL=https://localhost:9443
SX_DEV_ORIGINS=
SX_COOKIE_SECURE=1
SX_TRUST_PROXY_HEADERS=1

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=echo
POSTGRES_PASSWORD=<openssl-rand-hex-32>
POSTGRES_DB=echo

# ── Secrets ─────────────────────────────────────────────────────────────────
SX_SECURITY_SECRET=<long-random-secret>
SX_MESSAGE_ENCRYPTION_KEY=<different-long-random-secret>
SX_FAL_KEY_ENCRYPTION_KEY=<third-independent-long-random-secret>

# ── SeaweedFS standing in for R2 ────────────────────────────────────────────
# The app key pair; SeaweedFS also lets anonymous clients read the public
# bucket (deploy/compose.staging.yaml). R2_ACCOUNT_ID only has to be non-empty.
R2_ENDPOINT_URL=http://objectstore:8333
R2_ACCOUNT_ID=local-staging
R2_ACCESS_KEY_ID=staging-app
R2_SECRET_ACCESS_KEY=<openssl-rand-hex-32>
R2_PUBLIC_BUCKET=echo-public
STAGING_BACKUP_BUCKET=echo-backups

# ── fal.ai: blank keeps the rehearsal free (local engines only) ─────────────
FAL_KEY=
SX_FAL_MAX_QUOTE_USD=10

# ── Access: same invite-only shape as production ────────────────────────────
SX_REGISTRATION_ENABLED=0
SX_REGISTRATION_ALLOWLIST=alice@example.com,bob@example.com
SX_SESSION_DAYS=30
SX_ADMIN_USERS=alice@example.com
SX_MODERATOR_USERS=
SX_PASSWORD_RESET_EXPOSE_TOKEN=0

# ── Capacity: production values ─────────────────────────────────────────────
SX_MAX_VIDEO_UPLOAD_MB=95
SX_MAX_IMAGE_UPLOAD_MB=50
SX_UPLOAD_HOURLY_MAX=30
SX_VIDEO_WORKERS=1
SX_IMAGE_WORKERS=2
SX_MAX_PENDING_JOBS=6
SX_MAX_JOBS_PER_USER=2
SX_STAGED_BYTES_MAX=2147483648
SX_DISK_MIN_FREE_GB=5
SX_JOB_RETENTION_S=21600
SX_FFMPEG_THREADS=2
SX_FFMPEG_NICE=10

SX_QUOTE_RPM=15
SX_PACK_CREATE_HOURLY=10
# Production is 5/hour and 20/day; raised so scripts/verify_staging.cjs can
# be re-run. Every other limit keeps its production value.
SX_PUBLISH_HOURLY_MAX=60
SX_PUBLISH_DAILY_MAX=200
SX_SSE_MAX_CONN=8
SX_SSE_MAX_MIN=30

SX_REEL_PACK_CREATION_ENABLED=1
SX_REEL_PACK_DISCOVERY_ENABLED=1
SX_REEL_PACK_IMMERSIVE_ENABLED=1

SX_CREDITS_ENABLED=0
SX_STRIPE_ENABLED=0
SX_REEL_REWARDS_ENABLED=0

# ── Mailpit (deploy/compose.staging.yaml), plain SMTP on the compose network ─
SX_SMTP_HOST=mailpit
SX_SMTP_PORT=1025
SX_SMTP_USERNAME=
SX_SMTP_PASSWORD=
SX_SMTP_FROM=no-reply@example.com
SX_SMTP_SSL=0
SX_SMTP_STARTTLS=0

# ── Support inbox ────────────────────────────────────────────────────────────
# Gets one email per /support request (category, ID, subject; no body).
# Blank logs the request only. Uses the SMTP settings above.
SX_SUPPORT_EMAIL=support@example.com
