{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["server.app:app", "--reload", "--reload-dir", "server", "--reload-dir", "pipeline", "--reload-dir", "core", "--timeout-graceful-shutdown", "2", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "docs",
      "runtimeExecutable": "node",
      "runtimeArgs": ["web/node_modules/vite/bin/vite.js", "docs", "--port", "8765", "--strictPort"],
      "port": 8765
    }
  ]
}
