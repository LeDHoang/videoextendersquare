# The Dockerfile copies an explicit allowlist into the final image; this file
# keeps the build context small and stops host artifacts (notably a macOS
# web/node_modules) from overlaying the Linux `npm ci` output in the web stage.

# Virtualenvs — the project env is .venv (the old 'venv/' entry was a typo that
# matched nothing, letting a 1.3 GB local env leak into build context)
.venv/
venv/

# VCS / metadata
.git/
.gitignore
.github/
.DS_Store

# Python build artifacts
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
build/

# Node / built frontend (rebuilt inside the image)
**/node_modules
**/dist
server/static*
.vite/

# Local state, user data, and secrets — must never be baked into the image
.env
.env.*
!.env.example
data/
logs/
reports/
input/
output/
*.ffindex

# Remotion project (1.4 GB, lives on the video branch)
video/

# Local model caches and tooling sandboxes
.models/
ComfyUI/
.stitch/
antigravityskill/
.claude/
.agents/
.streamlit/
.vscode/

# Tests and docs are not needed at runtime
tests/
docs/
web/tests/
scripts/
*.cjs
test_*.py
